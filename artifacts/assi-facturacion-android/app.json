{
  "expo": {
    "name": "Facturación ASSI",
    "slug": "assi-facturacion-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "assi-facturacion-android",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.assi.facturacion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#12365a"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/assi-wordmark.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#eef3f2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
