modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "invoice-numbering"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow]]
name = "invoice-numbering"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/services/invoice-numbering.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[userenv]

[userenv.shared]
OWNER_EMAIL = "kcodguez@gmail.com"

[userenv.production]
ASSI_PRODUCTION_TEST_CLEANUP = "true"
ASSI_PRODUCTION_TEST_CLEANUP_TARGETS = "{\"invoices\":[{\"id\":2,\"number\":\"FAC-2026-000002\",\"versatNumber\":\"HAB-26-091\",\"talon\":\"5\"},{\"id\":305,\"number\":\"FAC-2026-000305\",\"versatNumber\":\"HAB-26-092\",\"talon\":\"5\"}],\"expenses\":[{\"id\":1,\"period\":\"2026-10\"}]}"

[objectStorage]
defaultBucketID = "replit-objstore-a6d0d251-3729-4537-8506-bfd9f9a1ecbb"
